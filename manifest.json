{
  "manifest_version": 3,
  "name": "Lazy Notes",
  "version": "1.0",
  "description": "Highlight text on any page, tag it by category, save it as a structured note.",

  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "sidePanel",
    "tabs",
    "downloads",
    "activeTab",
    "scripting",
    "commands"
  ],

  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file:///*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["pdf-prompt.js"],
      "run_at": "document_idle"
    }
  ],

  "commands": {
    "toggle-highlighter": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Toggle the Lazy Notes highlighter on or off"
    },
    "create-course": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Open the create-course form"
    }
  },

  "side_panel": {
    "default_path": "sidepanel.html"
  },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "action": {
    "default_title": "Lazy Notes",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
